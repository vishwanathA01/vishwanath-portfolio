# --- Admin sign-in (required for /admin) ---
ADMIN_EMAIL=admin@example.com
# Plain text or a bcrypt hash (see README)
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters

# --- Storage (optional) ---
# Leave empty to store content in data/*.json files (great for local editing).
# Set for production so the admin panel can edit content on the live site.
MONGODB_URI=
MONGODB_DB=portfolio

# --- GitHub (optional) ---
# Can also be set from Admin → Settings.
GITHUB_USERNAME=
# Personal access token (no scopes needed) raises the API rate limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# --- AI assistant (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

NEXT_PUBLIC_SITE_URL=http://localhost:3000
